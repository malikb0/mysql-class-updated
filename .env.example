# Copy to .env (gitignored) and adjust if needed. These are LOCAL, throwaway
# values for a Dockerised MySQL — never commit a real .env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3310
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=shopdb
MYSQL_USER=shop
MYSQL_PASSWORD=shop

# Optional: path to a local archive holding the practice datasets
# (a folder with `sakila-db/` and `test_db/`). Used only when downloads fail.
# MYSQL_CLASS_ARCHIVE=
